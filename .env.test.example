# Copy to .env.test. Used by `pnpm test` (Vitest) and `pnpm test:db:*`.
# Points at a dedicated test database — never the dev database — so test
# runs can freely truncate/reset data.

NODE_ENV=test
LOG_LEVEL=silent

POSTGRES_USER=pilot
POSTGRES_PASSWORD=pilot_test_only
POSTGRES_DB=venture_pilot_test
POSTGRES_PORT=55432
DATABASE_URL=postgresql://pilot:pilot_test_only@localhost:55432/venture_pilot_test?schema=public

API_PORT=4100
API_BASE_URL=http://localhost:4100

ADMIN_API_TOKEN=test-only-admin-token
TOKEN_PEPPER=test-only-token-pepper

DEFAULT_TRIAL_DURATION_DAYS=7
EXPIRING_SOON_THRESHOLD_HOURS=48
EXPORT_RETENTION_DAYS=14
DESTRUCTION_GRACE_DAYS=3

RATE_LIMIT_REDEMPTION_MAX=10
RATE_LIMIT_REDEMPTION_WINDOW_MS=60000
RATE_LIMIT_ADMIN_AUTH_MAX=30
RATE_LIMIT_ADMIN_AUTH_WINDOW_MS=60000

WORKER_SWEEP_INTERVAL_SECONDS=60
