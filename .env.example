# Copy to .env for local development (docker-compose reads this file directly).
# Never commit a real .env. All values below are safe local-only defaults.

NODE_ENV=development
LOG_LEVEL=info

# --- Database -----------------------------------------------------------
POSTGRES_USER=pilot
POSTGRES_PASSWORD=pilot_dev_only
POSTGRES_DB=venture_pilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pilot:pilot_dev_only@localhost:5432/venture_pilot?schema=public

# --- API ------------------------------------------------------------------
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Shared-secret admin bearer token (MVP only). Generate a real random value
# locally, e.g.: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# This is a placeholder for real SSO/RBAC before any non-local use.
ADMIN_API_TOKEN=dev-only-admin-token-change-me

# HMAC pepper used to hash invitation/session tokens at rest. Generate the
# same way as ADMIN_API_TOKEN. Rotating this invalidates all outstanding
# tokens (by design — see docs/TOKEN_SECURITY.md).
TOKEN_PEPPER=dev-only-token-pepper-change-me

# --- Trial / lifecycle policy defaults ------------------------------------
DEFAULT_TRIAL_DURATION_DAYS=7
EXPIRING_SOON_THRESHOLD_HOURS=48
EXPORT_RETENTION_DAYS=14
DESTRUCTION_GRACE_DAYS=3

# --- Rate limiting (in-memory, single-process; see docs/TOKEN_SECURITY.md) -
RATE_LIMIT_REDEMPTION_MAX=10
RATE_LIMIT_REDEMPTION_WINDOW_MS=60000
RATE_LIMIT_ADMIN_AUTH_MAX=30
RATE_LIMIT_ADMIN_AUTH_WINDOW_MS=60000

# --- Worker -----------------------------------------------------------------
WORKER_SWEEP_INTERVAL_SECONDS=60

# --- Frontend build-time vars ------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
